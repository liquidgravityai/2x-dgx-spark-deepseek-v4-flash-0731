# Copy this file to .env on each Spark and fill every REQUIRED value.
# The two nodes use the same MASTER_ADDR and different NODE_RANK/VLLM_HOST_IP.
#
# KNOWN-WORKING LAB EXAMPLE (replace these addresses and paths for your lab):
#
# Rank 0 / API node:
#   NODE_RANK=0
#   MASTER_ADDR=169.254.97.143
#   VLLM_HOST_IP=169.254.97.143
#
# Rank 1 / worker node:
#   NODE_RANK=1
#   MASTER_ADDR=169.254.97.143
#   VLLM_HOST_IP=169.254.243.47
#
# Values used on both nodes in that deployment:
#   FABRIC_IFACE=enp1s0f0np0
#   IB_HCA=rocep1s0f0
#   IB_GID_INDEX=3
#   MODEL_HOST_PATH=/data/models/DeepSeek-V4-Flash-0731
#   CACHE_HOST_PATH=/data/cache/deepseek-v4-flash-0731
#
# MASTER_ADDR and VLLM_HOST_IP are RoCE fabric addresses, not management-LAN
# addresses. FABRIC_IFACE is a Linux interface name, IB_HCA is an RDMA device
# name, and IB_GID_INDEX is a decimal table index reported by show_gids.
# Filesystem paths are sanitized examples; they need only be absolute, local,
# and point to the model and a writable cache on each node.

# REQUIRED: 0 on the API/head node, 1 on the worker node.
NODE_RANK=

# REQUIRED: address of rank 0 on the high-speed fabric.
MASTER_ADDR=

# REQUIRED: this node's address on the high-speed fabric.
VLLM_HOST_IP=

# REQUIRED: Linux interface carrying the high-speed node-to-node traffic.
FABRIC_IFACE=

# REQUIRED: RDMA device exposed by /dev/infiniband.
IB_HCA=

# REQUIRED: RoCE GID index matching VLLM_HOST_IP on IB_HCA.
IB_GID_INDEX=

# REQUIRED: absolute host paths. The cache directory must be writable.
MODEL_HOST_PATH=
CACHE_HOST_PATH=

# Optional API and rendezvous settings.
API_PORT=8000
MASTER_PORT=29501
SERVED_MODEL_NAME=deepseek-v4-flash-0731
# Default renderer effort; API requests may still override reasoning_effort.
DEEPSEEK_REASONING_EFFORT=max

# Validated memory/concurrency profile. Change only after re-benchmarking.
GPU_MEMORY_UTILIZATION=0.82
# Explicit bytes per rank; validated aggregate GPU KV capacity is 1,113,832 tokens.
KV_CACHE_MEMORY_BYTES=20000000000
MAX_MODEL_LEN=270000
MAX_NUM_BATCHED_TOKENS=4096
MAX_NUM_SEQS=4

# Validated speculative-decoding profile.
NUM_SPECULATIVE_TOKENS=6
DSPARK_DRAFT_SAMPLE_METHOD=greedy
DSPARK_SPS_CURVE=auto

# Keep these disabled for the published image unless requalified.
VLLM_DSPARK_FP8_DRAFT_HEAD=0
VLLM_DSPARK_DYNAMIC_DRAFT_DEPTH=0
ENABLE_FLASHINFER_AUTOTUNE=0
ENABLE_PREFIX_CACHING=0

+class _ToolExclusiveGenerationGate:
+    """Allow ordinary chat generations to overlap while tool calls run alone."""
+
+    def __init__(self) -> None:
+        self._condition = asyncio.Condition()
+        self._shared = 0
+        self._exclusive = False
+        self._exclusive_waiters = 0
+
+    async def _acquire(self, exclusive: bool) -> None:
+        async with self._condition:
+            if exclusive:
+                self._exclusive_waiters += 1
+                try:
+                    await self._condition.wait_for(
+                        lambda: not self._exclusive and self._shared == 0
+                    )
+                    self._exclusive = True
+                finally:
+                    self._exclusive_waiters -= 1
+                    self._condition.notify_all()
+            else:
+                await self._condition.wait_for(
+                    lambda: not self._exclusive and self._exclusive_waiters == 0
+                )
+                self._shared += 1
+
+    async def _release(self, exclusive: bool) -> None:
+        async with self._condition:
+            if exclusive:
+                self._exclusive = False
+            else:
+                self._shared -= 1
+            self._condition.notify_all()
+
+    async def run(self, generator, exclusive: bool):
+        await self._acquire(exclusive)
+        try:
+            async for item in generator:
+                yield item
+        finally:
+            await self._release(exclusive)
+

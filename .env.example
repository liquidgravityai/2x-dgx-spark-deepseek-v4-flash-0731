# Copy this file to .env on each Spark and fill every REQUIRED value.
# Both nodes use the same MASTER_ADDR and different NODE_RANK values.
#
# KNOWN-WORKING LAB EXAMPLE (replace these addresses and paths for your lab):
#
# Rank 0 / API node:
#   NODE_RANK=0
#   MASTER_ADDR=169.254.97.143
#
# Rank 1 / worker node:
#   NODE_RANK=1
#   MASTER_ADDR=169.254.97.143
#
# Values used on both nodes in that deployment:
#   FABRIC_IFACE=enp1s0f0np0
#   IB_HCA=rocep1s0f0
#   IB_GID_INDEX=3
#   MODEL_HOST_PATH=/data/models/DeepSeek-V4-Flash-0731
#   CACHE_HOST_PATH=/data/cache/deepseek-v4-flash-0731-sglang
#
# MASTER_ADDR is rank 0's RoCE fabric address, not its management-LAN address.
# FABRIC_IFACE is a Linux interface name, IB_HCA is an RDMA device name, and
# IB_GID_INDEX is the decimal table index reported by show_gids.

# REQUIRED: 0 on the API/head node, 1 on the worker node.
NODE_RANK=

# REQUIRED: address of rank 0 on the high-speed fabric.
MASTER_ADDR=

# REQUIRED: Linux interface carrying high-speed node-to-node traffic.
FABRIC_IFACE=

# REQUIRED: RDMA device exposed by /dev/infiniband.
IB_HCA=

# REQUIRED: RoCE GID index for MASTER_ADDR on IB_HCA.
IB_GID_INDEX=

# REQUIRED: absolute host paths. The cache directory must be writable.
MODEL_HOST_PATH=
CACHE_HOST_PATH=

# Optional API and rendezvous settings.
API_PORT=8000
MASTER_PORT=20000
SERVED_MODEL_NAME=deepseek-v4-flash-0731
DEEPSEEK_REASONING_EFFORT=max

# Validated memory and concurrency profile. Change only after re-benchmarking.
MEM_FRACTION_STATIC=0.82
MAX_TOTAL_TOKENS=1113832
MAX_MODEL_LEN=270000
MAX_NUM_SEQS=4
CHUNKED_PREFILL_SIZE=8192
MAX_PREFILL_TOKENS=16384
SWA_FULL_TOKENS_RATIO=0.1
CUDA_GRAPH_MAX_BS=4

# Validated DSpark profile. Block size 5 gives a six-token verify window.
DSPARK_BLOCK_SIZE=5
RAGGED_VERIFY_MODE=compact

# Validated launch scheduling.
CUDA_DEVICE_MAX_CONNECTIONS=1
